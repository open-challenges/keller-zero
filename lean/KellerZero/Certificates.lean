import KellerZero.Gadget

/-!
# Nullstellensatz certificates for the gadget

Polynomial identities with integer coefficients, each checked by `ring`. Writing
`H = (12 P + 3, 12 Q, 12 R)` for the rescaled gadget:

* `curve_certificate`: one identity, uniform in `t`, that shows the gadget never takes a value
  on the curve `12 P = t ^ 2`, `Q = t`, `3 t R = 4`: a combination of the three equations equals
  `4 t`. The products have degree at most 10 in `x, y, z`.
* `target_certificate`: the same for the one target `(7, 24, 8)` of the reduction.
* `cube_certificate`, `y_certificate`, `z_certificate`: the ideal generated by the coordinates of
  `H` contains `x ^ 3 - x`, `2 y + 3 x` and `4 z + 1 - 27 x ^ 2` (after multiplying by 24, 12 and
  48), so it is the ideal of the three zeros of `H`.
* `quartic_certificate`: it contains `x ^ 4 - x ^ 2`; this is the Boolean axiom of the variable
  `x ^ 2` that the reduction reads.

`not_on_curve` and `zeros_of_H` draw the consequences over every field in which `2` and `3` are
not zero. They are found by exact linear algebra (`scripts/certificates.py`).
-/

namespace KellerZero

variable {K : Type*} [Field K]

/-- A combination of the three equations of a point of the omitted curve is `4 t`. -/
theorem curve_certificate (x y z t : K) :
    x * (2 * (1 + x * y) - t * x) * (12 * P x y z - t ^ 2)
      + (t ^ 2 * x ^ 2 + 2 * t * x * (x * y + 2) - 8 * (1 + x * y) ^ 2) * (Q x y z - t)
      + (t - 2 * y) * (1 + x * y) ^ 2 * (3 * t * R x y z - 4) = 4 * t := by
  simp only [P, Q, R]
  ring

/-- The gadget takes no value on the omitted curve, over every field in which `2 ≠ 0`. -/
theorem not_on_curve (h2 : (2 : K) ≠ 0) (t : K) (ht : t ≠ 0) (x y z : K) :
    ¬ (12 * P x y z = t ^ 2 ∧ Q x y z = t ∧ 3 * t * R x y z = 4) := by
  rintro ⟨h1, h2', h3⟩
  have h := curve_certificate x y z t
  rw [h1, h2', h3] at h
  have h4 : (4 : K) * t = 0 := by rw [← h]; ring
  have : (4 : K) ≠ 0 := by
    have : (4 : K) = 2 * 2 := by norm_num
    rw [this]
    exact mul_ne_zero h2 h2
  exact (mul_ne_zero this ht) h4

/-- A combination of the three equations `H = (7, 24, 8)` is `24`. -/
theorem target_certificate (x y z : K) :
    (6 * x ^ 2 * y - 6 * x ^ 2 + 6 * x) * (12 * P x y z + 3 - 7)
      + (-2 * x ^ 2 * y ^ 2 + x ^ 2 * y + x ^ 2 - 4 * x * y + 2 * x - 2) * (12 * Q x y z - 24)
      + (-3 * x ^ 2 * y ^ 3 + 3 * x ^ 2 * y ^ 2 - 6 * x * y ^ 2 + 6 * x * y - 3 * y + 3)
        * (12 * R x y z - 8) = 24 := by
  simp only [P, Q, R]
  ring

theorem cube_certificate (x y z : K) :
    8 * x ^ 3 * (12 * P x y z + 3) + (-2 * x ^ 3 * y - 3 * x ^ 2) * (12 * Q x y z)
      + (2 * x ^ 3 * y ^ 3 + 3 * x ^ 2 * y ^ 2 - 1) * (12 * R x y z) = 24 * (x ^ 3 - x) := by
  simp only [P, Q, R]
  ring

theorem quartic_certificate (x y z : K) :
    8 * x ^ 4 * (12 * P x y z + 3) + (-2 * x ^ 4 * y - 3 * x ^ 3) * (12 * Q x y z)
      + (2 * x ^ 4 * y ^ 3 + 3 * x ^ 3 * y ^ 2 - x) * (12 * R x y z) = 24 * (x ^ 4 - x ^ 2) := by
  simp only [P, Q, R]
  ring

theorem y_certificate (x y z : K) :
    12 * x * (12 * P x y z + 3) + (-3 * x ^ 2 * z - 12 * x * y + 2) * (12 * Q x y z)
      + (-9 * x ^ 2 * y ^ 2 * z - 24 * x * y ^ 3 - 18 * x * y * z - 30 * y ^ 2 - 9 * z)
        * (12 * R x y z) = 12 * (2 * y + 3 * x) := by
  simp only [P, Q, R]
  ring

theorem z_certificate (x y z : K) :
    (-36 * x ^ 2 * z - 432 * x ^ 2 + 132 * x * y + 16) * (12 * P x y z + 3)
      + (12 * x ^ 2 * y * z + 108 * x ^ 2 * y - 24 * x * y ^ 2 + 12 * x * z + 147 * x - 64 * y)
        * (12 * Q x y z)
      + (-108 * x ^ 2 * y ^ 3 + 60 * x * y ^ 4 - 207 * x * y ^ 2 + 76 * y ^ 3 - 90 * y)
        * (12 * R x y z) = 48 * (4 * z + 1 - 27 * x ^ 2) := by
  simp only [P, Q, R]
  ring

/-- The zeros of `H`, over every field in which `2` and `3` are not zero: `x` is `0`, `1` or
`-1`, and `y` and `z` are determined by `x`. -/
theorem zeros_of_H (h2 : (2 : K) ≠ 0) (h3 : (3 : K) ≠ 0) (x y z : K)
    (hP : 12 * P x y z + 3 = 0) (hQ : 12 * Q x y z = 0) (hR : 12 * R x y z = 0) :
    x ^ 3 = x ∧ 2 * y + 3 * x = 0 ∧ 4 * z + 1 = 27 * x ^ 2 := by
  have h4 : (4 : K) ≠ 0 := by
    have : (4 : K) = 2 * 2 := by norm_num
    rw [this]; exact mul_ne_zero h2 h2
  have h12 : (12 : K) ≠ 0 := by
    have : (12 : K) = 4 * 3 := by norm_num
    rw [this]; exact mul_ne_zero h4 h3
  have h24 : (24 : K) ≠ 0 := by
    have : (24 : K) = 2 * 12 := by norm_num
    rw [this]; exact mul_ne_zero h2 h12
  have h48 : (48 : K) ≠ 0 := by
    have : (48 : K) = 2 * 24 := by norm_num
    rw [this]; exact mul_ne_zero h2 h24
  have c1 := cube_certificate x y z
  have c2 := y_certificate x y z
  have c3 := z_certificate x y z
  rw [hP, hQ, hR] at c1 c2 c3
  simp only [mul_zero, add_zero] at c1 c2 c3
  refine ⟨?_, ?_, ?_⟩
  · have := (mul_eq_zero.mp c1.symm).resolve_left h24
    exact sub_eq_zero.mp this
  · exact (mul_eq_zero.mp c2.symm).resolve_left h12
  · have := (mul_eq_zero.mp c3.symm).resolve_left h48
    exact sub_eq_zero.mp this

end KellerZero
